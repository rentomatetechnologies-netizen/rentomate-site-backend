# Copy to .env and fill in. Never commit .env.

# ---- Local development (npm run dev) ----
# PostgreSQL connection string. Only this backend connects to the database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rentomate?schema=public"
PORT=4000
# Plain http in development: allow the session cookie without HTTPS.
COOKIE_SECURE=false
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Folder for uploaded images (saved as blog/img1.jpg, hero/img1.png, …). Default: ../uploads next to this project.
# UPLOADS_DIR=E:\rentOmate\uploads

# ---- Shared ----
# First admin, created on startup / `npm run db:seed` when no admin exists yet.
# Afterwards manage admins from the Admins page or `npm run admin:create -- <username>`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string; must match REVALIDATE_SECRET in the website's environment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# ---- Docker (docker compose up) ----
# Used to create the Postgres container and build DATABASE_URL for the API container.
# Use letters and digits only in the password (it goes into a URL).
POSTGRES_USER=rentomate
POSTGRES_PASSWORD=
POSTGRES_DB=rentomate
# Host port the API is published on. The website's BACKEND_URL points here.
BACKEND_PORT=4000
# The website's revalidate endpoint as seen from inside the container.
# Website running on this machine: http://host.docker.internal:3000/api/revalidate (default)
# Website deployed elsewhere:      https://rentomate.life/api/revalidate
DOCKER_FRONTEND_REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate
